{
  "expo": {
    "name": "Diario Giornaliero",
    "slug": "daily-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dailyjournal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.personal.dailyjournal",
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#4F8DF7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

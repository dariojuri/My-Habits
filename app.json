{
  "expo": {
    "name": "My Habits",
    "slug": "daily-journal",
    "owner": "dariojuri",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dailyjournal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.personal.dailyjournal",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8283e554-c064-4c3c-aadf-8cd924920b87"
      }
    }
  }
}
